# 14. Summarise protection by connectivity score --------------------------

summarise_protection_by_score <- function(
    scored_grid,
    score_col,
    score_type,
    selection) {

  data <- scored_grid |>
    st_drop_geometry()

  summarise_one <- function(x, sovereign_name) {

    score <- x[[score_col]]

    tibble(
      sovereign_state = sovereign_name,
      selection = selection,
      score_type = score_type,
      grid_size_km = GRID_SIZE_KM,

      n_connectivity_cells = nrow(x),

      connectivity_cell_area_km2 =
        sum(x$cell_area_km2, na.rm = TRUE),

      protected_connectivity_cell_area_km2 =
        sum(x$protected_area_km2, na.rm = TRUE),

      mpa_only_connectivity_cell_area_km2 =
        sum(x$mpa_only_area_km2, na.rm = TRUE),

      oecm_only_connectivity_cell_area_km2 =
        sum(x$oecm_only_area_km2, na.rm = TRUE),

      overlap_connectivity_cell_area_km2 =
        sum(x$overlap_area_km2, na.rm = TRUE),

      unprotected_connectivity_cell_area_km2 =
        sum(x$unprotected_area_km2, na.rm = TRUE),

      raw_score_sum =
        sum(score, na.rm = TRUE),

      score_area_total =
        sum(score * x$cell_area_km2, na.rm = TRUE),

      score_area_protected =
        sum(score * x$protected_area_km2, na.rm = TRUE),

      score_area_mpa_only =
        sum(score * x$mpa_only_area_km2, na.rm = TRUE),

      score_area_oecm_only =
        sum(score * x$oecm_only_area_km2, na.rm = TRUE),

      score_area_overlap =
        sum(score * x$overlap_area_km2, na.rm = TRUE),

      score_area_unprotected =
        sum(score * x$unprotected_area_km2, na.rm = TRUE)
    ) |>
      mutate(
        # MPA and OECM totals include their shared overlap.
        score_area_mpa =
          score_area_mpa_only + score_area_overlap,

        score_area_oecm =
          score_area_oecm_only + score_area_overlap,

        percent_connectivity_cell_area_protected =
          100 * safe_divide(
            protected_connectivity_cell_area_km2,
            connectivity_cell_area_km2
          ),

        percent_connectivity_cell_area_mpa_only =
          100 * safe_divide(
            mpa_only_connectivity_cell_area_km2,
            connectivity_cell_area_km2
          ),

        percent_connectivity_cell_area_oecm_only =
          100 * safe_divide(
            oecm_only_connectivity_cell_area_km2,
            connectivity_cell_area_km2
          ),

        percent_connectivity_cell_area_overlap =
          100 * safe_divide(
            overlap_connectivity_cell_area_km2,
            connectivity_cell_area_km2
          ),

        percent_score_weighted_area_protected =
          100 * safe_divide(
            score_area_protected,
            score_area_total
          ),

        percent_score_weighted_area_mpa =
          100 * safe_divide(
            score_area_mpa,
            score_area_total
          ),

        percent_score_weighted_area_oecm =
          100 * safe_divide(
            score_area_oecm,
            score_area_total
          ),

        percent_score_weighted_area_mpa_only =
          100 * safe_divide(
            score_area_mpa_only,
            score_area_total
          ),

        percent_score_weighted_area_oecm_only =
          100 * safe_divide(
            score_area_oecm_only,
            score_area_total
          ),

        percent_score_weighted_area_overlap =
          100 * safe_divide(
            score_area_overlap,
            score_area_total
          ),

        percent_score_weighted_area_unprotected =
          100 * safe_divide(
            score_area_unprotected,
            score_area_total
          )
      )
  }

  country_rows <- lapply(
    zone_eez$sovereign_state,
    function(country) {
      summarise_one(
        x = data |>
          filter(sovereign_state == country),
        sovereign_name = country
      )
    }
  ) |>
    bind_rows()

  wio_row <- summarise_one(
    x = data,
    sovereign_name = "WIO"
  )

  bind_rows(
    country_rows,
    wio_row
  )
}



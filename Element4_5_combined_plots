# ============================================================
# COMBINED ELEMENT 4 + ELEMENT 5 CONNECTIVITY FIGURE
# ============================================================
#
# Loads previously generated Element 4 and Element 5 summary CSVs and
# produces:
#   1. Circular country plot
#   2. WIO total % protected horizontal bar plot
#   3. Combined WIO summary + circular figure
#
# Indicators:
#   - Migratory Connectivity (MiCO)
#   - Fish larval connectivity
#   - Top larval sources
#   - Top larval sinks
#
# ============================================================


# 1. Packages -------------------------------------------------------------

library(dplyr)
library(tibble)
library(stringr)
library(ggplot2)
library(readr)
library(patchwork)


# 2. Input / output --------------------------------------------------------

ELEMENT4_CSV <- file.path(
  "outputs",
  "element4",
  "mico_grid_50km",
  "element4_connectivity_protection_by_eez.csv"
)

ELEMENT5_CSV <- file.path(
  "outputs",
  "element5",
  "larval_sources_sinks",
  "element5_larval_sources_sinks_protection_by_sovereign.csv"
)

OUTPUT_DIR <- file.path(
  "outputs",
  "element4_5_combined_connectivity"
)

PLOT_DIR <- file.path(
  OUTPUT_DIR,
  "plots"
)

dir.create(
  OUTPUT_DIR,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  PLOT_DIR,
  recursive = TRUE,
  showWarnings = FALSE
)


# 3. Plot settings ---------------------------------------------------------

COUNTRY_ORDER <- c(
  "Comoros",
  "France",
  "Kenya",
  "Madagascar",
  "Mauritius",
  "Mozambique",
  "Seychelles",
  "Somalia",
  "South Africa",
  "Tanzania"
)

COUNTRY_CODES <- c(
  "Comoros"      = "COM",
  "France"       = "FRA",
  "Kenya"        = "KEN",
  "Madagascar"   = "MDG",
  "Mauritius"    = "MUS",
  "Mozambique"   = "MOZ",
  "Seychelles"   = "SYC",
  "Somalia"      = "SOM",
  "South Africa" = "ZAF",
  "Tanzania"     = "TZA"
)

PLOT_DROP_COUNTRIES <- character(0)

INDICATOR_ORDER <- c(
  "Migratory Connectivity (MiCO)",
  "Larval Connectivity",
  "Top larval sources",
  "Top larval sinks"
)

INDICATOR_LABELS <- c(
  "Migratory Connectivity (MiCO)" =
    "Migratory connectivity (MiCO)",
  "Larval Connectivity" =
    "Larval connectivity",
  "Top larval sources" =
    "Top larval sources",
  "Top larval sinks" =
    "Top larval sinks"
)

INDICATOR_COLOURS <- c(
  "Migratory Connectivity (MiCO)" = "#554d8f",
  "Larval Connectivity"           = "#369b97",
  "Top larval sources"            = "#4388AE",
  "Top larval sinks"              = "#50BEAE"
)

LEGEND_TITLE <- "Connectivity indicators"

# Circular plot
EMPTY_BARS <- 3
BAR_WIDTH <- 0.78

POLAR_START_DEG <- 0
POLAR_DIRECTION <- 1

RADIAL_BREAKS <- c(20, 40, 60, 80, 100)

RING_COLOURS <- c(
  "#D5D8D9",
  "#DEE0E1",
  "#D5D8D9",
  "#DEE0E1",
  "#ECEDED"
)

INNER_YMIN <- -52
INNER_YMAX <- 0
INNER_FILL <- "#E7E7E7"

COUNTRY_ARC_YMIN <- -4.4
COUNTRY_ARC_YMAX <- -3.1
COUNTRY_ARC_COLOUR <- "#303030"

COUNTRY_LABEL_Y <- -14
COUNTRY_LABEL_SIZE <- 4.1
COUNTRY_LABEL_COLOUR <- "#333333"

SCALE_LABEL_SIZE <- 3.2
SCALE_LABEL_X_NUDGE <- 0
SCALE_LABEL_COLOUR <- "#111111"

CIRCULAR_FIGURE_WIDTH <- 11
CIRCULAR_FIGURE_HEIGHT <- 11

# WIO summary plot
WIO_SUMMARY_TITLE <- "Total % protected in WIO"

WIO_X_MAX <- 50
WIO_X_BREAKS <- seq(
  0,
  WIO_X_MAX,
  by = 10
)

WIO_BAR_WIDTH <- 0.72


WIO_REFERENCE_N_INDICATORS <- 5

# Combined figure
COMBINED_LEFT_RIGHT_WIDTHS <- c(1, 1)
COMBINED_TOP_BOTTOM_HEIGHTS <- c(1.20, 0.80)

COMBINED_FIGURE_WIDTH <- 16
COMBINED_FIGURE_HEIGHT <- 10

COMBINED_LEGEND_TITLE_SIZE <- 14
COMBINED_LEGEND_TEXT_SIZE <- 4.8
COMBINED_LEGEND_KEY_SIZE <- 9
COMBINED_LEGEND_KEY_X <- 0.035
COMBINED_LEGEND_TEXT_X <- 0.095


# 4. Helpers ---------------------------------------------------------------

append_unlisted_levels <- function(preferred, observed) {
  c(
    intersect(preferred, observed),
    setdiff(observed, preferred)
  )
}

country_code <- function(country) {

  country <- as.character(country)
  code <- unname(COUNTRY_CODES[country])

  missing_code <- is.na(code) | !nzchar(code)

  if (any(missing_code)) {
    code[missing_code] <- str_to_upper(
      str_sub(
        country[missing_code],
        1,
        3
      )
    )
  }

  code
}

standardise_country <- function(x) {
  recode(
    as.character(x),
    "Comoro Islands" = "Comoros"
  )
}


# 5. Load and combine Element 4 + Element 5 -------------------------------

element4_data <- read_csv(
  ELEMENT4_CSV,
  show_col_types = FALSE
) |>
  filter(
    score_type == "two_dimensional_e4_score"
  ) |>
  transmute(
    sovereign_state = standardise_country(
      sovereign_state
    ),
    indicator = "Migratory Connectivity (MiCO)",
    value = as.numeric(
      percent_score_weighted_area_protected
    ),
    element = "Element 4"
  )


element5_data <- read_csv(
  ELEMENT5_CSV,
  show_col_types = FALSE
) |>
  filter(
    indicator %in% c(
      "Top larval sources",
      "Top larval sinks"
    )
  ) |>
  transmute(
    sovereign_state = standardise_country(
      sovereign_state
    ),
    indicator = as.character(indicator),
    value = as.numeric(
      percent_protected_total
    ),
    element = "Element 5"
  )


indicator_summary <- bind_rows(
  element4_data,
  element5_data
) |>
  filter(
    !is.na(sovereign_state),
    nzchar(sovereign_state),
    !is.na(indicator),
    nzchar(indicator),
    !is.na(value),
    is.finite(value)
  ) |>
  mutate(
    value = pmin(
      pmax(value, 0),
      100
    )
  ) |>
  group_by(
    sovereign_state,
    indicator,
    element
  ) |>
  summarise(
    value = first(value),
    .groups = "drop"
  )

write_csv(
  indicator_summary,
  file.path(
    OUTPUT_DIR,
    "element4_5_connectivity_indicator_summary.csv"
  )
)


# 6. Indicator and country order ------------------------------------------


observed_indicators <- unique(
  indicator_summary$indicator
)

preferred_indicator_levels <- append_unlisted_levels(
  preferred = INDICATOR_ORDER,
  observed = observed_indicators
)

wio_indicator_rank <- indicator_summary |>
  filter(
    sovereign_state == "WIO",
    indicator %in% observed_indicators
  ) |>
  mutate(
    preferred_rank = match(
      indicator,
      preferred_indicator_levels
    )
  ) |>
  arrange(
    value,
    preferred_rank
  )

indicator_levels <- c(
  wio_indicator_rank$indicator,
  setdiff(
    preferred_indicator_levels,
    wio_indicator_rank$indicator
  )
)

indicator_levels <- indicator_levels[
  indicator_levels %in% observed_indicators
]

country_data <- indicator_summary |>
  filter(
    sovereign_state != "WIO",
    sovereign_state != "Disputed",
    !sovereign_state %in% PLOT_DROP_COUNTRIES
  ) |>
  group_by(
    sovereign_state,
    indicator
  ) |>
  summarise(
    value = first(value),
    .groups = "drop"
  )

observed_countries <- unique(
  country_data$sovereign_state
)

country_levels <- append_unlisted_levels(
  preferred = COUNTRY_ORDER,
  observed = observed_countries
)


# 7. Circular plot layout --------------------------------------------------

layout_parts <- vector(
  "list",
  length(country_levels)
)

for (i in seq_along(country_levels)) {

  country <- country_levels[[i]]

  layout_parts[[i]] <- bind_rows(
    tibble(
      sovereign_state = country,
      indicator = indicator_levels,
      is_empty = FALSE
    ),
    tibble(
      sovereign_state = country,
      indicator = rep(
        NA_character_,
        EMPTY_BARS
      ),
      is_empty = TRUE
    )
  )
}

bar_layout <- bind_rows(
  layout_parts
) |>
  mutate(
    bar_id = row_number()
  )

plot_data <- bar_layout |>
  filter(
    !is_empty
  ) |>
  left_join(
    country_data,
    by = c(
      "sovereign_state",
      "indicator"
    )
  )

country_groups <- bar_layout |>
  group_by(
    sovereign_state
  ) |>
  summarise(
    start = min(
      bar_id[!is_empty]
    ) - 0.40,
    end = max(
      bar_id[!is_empty]
    ) + 0.40,
    title = mean(
      c(
        min(bar_id[!is_empty]),
        max(bar_id[!is_empty])
      )
    ),
    .groups = "drop"
  ) |>
  mutate(
    country_code = country_code(
      sovereign_state
    )
  )

n_bars <- nrow(
  bar_layout
)

ring_data <- tibble(
  xmin = 0.5,
  xmax = n_bars + 0.5,
  ymin = c(0, 20, 40, 60, 80),
  ymax = c(20, 40, 60, 80, 100),
  ring_fill = RING_COLOURS
)

inner_ring_data <- tibble(
  xmin = 0.5,
  xmax = n_bars + 0.5,
  ymin = INNER_YMIN,
  ymax = INNER_YMAX
)

last_gap_ids <- tail(
  bar_layout$bar_id[
    bar_layout$is_empty
  ],
  EMPTY_BARS
)

scale_label_data <- tibble(
  x = mean(last_gap_ids) +
    SCALE_LABEL_X_NUDGE,
  y = RADIAL_BREAKS,
  label = paste0(
    RADIAL_BREAKS,
    "%"
  )
)

indicator_colours <- INDICATOR_COLOURS[
  indicator_levels
]

indicator_labels <- INDICATOR_LABELS[
  indicator_levels
]


# 8. Circular country plot -------------------------------------------------

combined_circular_plot <- ggplot() +

  geom_rect(
    data = ring_data,
    aes(
      xmin = xmin,
      xmax = xmax,
      ymin = ymin,
      ymax = ymax
    ),
    fill = ring_data$ring_fill,
    colour = NA
  ) +

  geom_rect(
    data = inner_ring_data,
    aes(
      xmin = xmin,
      xmax = xmax,
      ymin = ymin,
      ymax = ymax
    ),
    fill = INNER_FILL,
    colour = NA
  ) +

  geom_col(
    data = plot_data,
    aes(
      x = bar_id,
      y = value,
      fill = indicator
    ),
    width = BAR_WIDTH,
    colour = NA,
    na.rm = TRUE
  ) +

  geom_rect(
    data = country_groups,
    aes(
      xmin = start,
      xmax = end,
      ymin = COUNTRY_ARC_YMIN,
      ymax = COUNTRY_ARC_YMAX
    ),
    inherit.aes = FALSE,
    fill = COUNTRY_ARC_COLOUR,
    colour = NA
  ) +

  geom_text(
    data = country_groups,
    aes(
      x = title,
      y = COUNTRY_LABEL_Y,
      label = country_code
    ),
    inherit.aes = FALSE,
    colour = COUNTRY_LABEL_COLOUR,
    fontface = "bold",
    size = COUNTRY_LABEL_SIZE
  ) +

  geom_text(
    data = scale_label_data,
    aes(
      x = x,
      y = y,
      label = label
    ),
    inherit.aes = FALSE,
    colour = SCALE_LABEL_COLOUR,
    fontface = "bold",
    size = SCALE_LABEL_SIZE,
    hjust = 0.5
  ) +

  scale_fill_manual(
    values = indicator_colours,
    breaks = indicator_levels,
    labels = indicator_labels,
    drop = FALSE,
    name = LEGEND_TITLE
  ) +

  scale_x_continuous(
    limits = c(
      0.5,
      n_bars + 0.5
    ),
    expand = c(0, 0)
  ) +

  scale_y_continuous(
    limits = c(
      INNER_YMIN,
      104
    ),
    expand = c(0, 0)
  ) +

  coord_polar(
    theta = "x",
    start = POLAR_START_DEG * pi / 180,
    direction = POLAR_DIRECTION,
    clip = "off"
  ) +

  theme_void() +

  theme(
    legend.position = "left",

    legend.title = element_text(
      face = "bold",
      size = 11
    ),

    legend.text = element_text(
      size = 10
    ),

    plot.margin = margin(
      5,
      10,
      5,
      10
    )
  )

ggsave(
  filename = file.path(
    PLOT_DIR,
    "element4_5_connectivity_circular.png"
  ),
  plot = combined_circular_plot,
  width = CIRCULAR_FIGURE_WIDTH,
  height = CIRCULAR_FIGURE_HEIGHT,
  dpi = 400,
  bg = "white"
)


# 9. WIO summary plot ------------------------------------------------------

wio_plot_data <- indicator_summary |>
  filter(
    sovereign_state == "WIO",
    indicator %in% indicator_levels
  ) |>
  mutate(
    wio_indicator_order = match(
      indicator,
      indicator_levels
    )
  ) |>
  arrange(
    wio_indicator_order
  )

n_wio_indicators <- nrow(
  wio_plot_data
)

WIO_DISPLAY_SLOTS <- max(
  WIO_REFERENCE_N_INDICATORS,
  n_wio_indicators
)

wio_plot_data <- wio_plot_data |>
  mutate(
    wio_slot_index =
      WIO_DISPLAY_SLOTS - row_number() + 1,

    wio_slot = factor(
      paste0(
        "slot_",
        wio_slot_index
      ),
      levels = paste0(
        "slot_",
        seq_len(WIO_DISPLAY_SLOTS)
      )
    ),

    indicator = factor(
      indicator,
      levels = indicator_levels
    )
  )

wio_summary_plot <- ggplot(
  wio_plot_data,
  aes(
    x = value,
    y = wio_slot,
    fill = indicator
  )
) +

  geom_col(
    width = WIO_BAR_WIDTH,
    colour = NA,
    orientation = "y"
  ) +

  scale_fill_manual(
    values = indicator_colours,
    breaks = indicator_levels,
    drop = FALSE,
    guide = "none"
  ) +

  scale_x_continuous(
    position = "top",
    breaks = WIO_X_BREAKS,
    labels = function(x) {
      paste0(x, "%")
    },
    expand = c(0, 0)
  ) +

  scale_y_discrete(
    drop = FALSE,
    labels = NULL,
    expand = expansion(
      add = 0.25
    )
  ) +

  coord_cartesian(
    xlim = c(
      0,
      WIO_X_MAX
    ),
    clip = "on"
  ) +

  labs(
    title = WIO_SUMMARY_TITLE,
    x = NULL,
    y = "Indicator"
  ) +

  theme_minimal(
    base_size = 11
  ) +

  theme(
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),

    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),

    axis.title.y = element_text(
      face = "bold",
      size = 13,
      margin = margin(
        r = 8
      )
    ),

    axis.text.x = element_text(
      size = 10,
      face = "bold",
      colour = "#444444"
    ),

    axis.ticks.x = element_line(
      colour = "#444444"
    ),

    plot.title = element_text(
      face = "bold",
      hjust = 0.5,
      size = 14,
      margin = margin(
        b = 8
      )
    ),

    plot.margin = margin(
      t = 8,
      r = 10,
      b = 2,
      l = 5
    )
  )

ggsave(
  filename = file.path(
    PLOT_DIR,
    "element4_5_connectivity_WIO_summary.png"
  ),
  plot = wio_summary_plot,
  width = 7,
  height = 5,
  dpi = 400,
  bg = "white"
)


# 10. Combined WIO + circular figure --------------------------------------

legend_panel_data <- tibble(
  indicator = indicator_levels,
  label = unname(
    indicator_labels[indicator_levels]
  ),
  legend_y = rev(
    seq_along(indicator_levels)
  )
) |>
  mutate(
    indicator = factor(
      indicator,
      levels = indicator_levels
    )
  )

legend_panel <- ggplot(
  legend_panel_data
) +

  geom_point(
    aes(
      x = COMBINED_LEGEND_KEY_X,
      y = legend_y,
      fill = indicator
    ),
    shape = 22,
    size = COMBINED_LEGEND_KEY_SIZE,
    stroke = 0,
    colour = NA
  ) +

  geom_text(
    aes(
      x = COMBINED_LEGEND_TEXT_X,
      y = legend_y,
      label = label
    ),
    hjust = 0,
    vjust = 0.5,
    size = COMBINED_LEGEND_TEXT_SIZE,
    colour = "#111111"
  ) +

  scale_fill_manual(
    values = indicator_colours,
    guide = "none"
  ) +

  scale_x_continuous(
    limits = c(0, 1),
    expand = c(0, 0)
  ) +

  scale_y_continuous(
    limits = c(
      0.3,
      length(indicator_levels) + 0.8
    ),
    expand = c(0, 0)
  ) +

  coord_cartesian(
    clip = "off"
  ) +

  labs(
    title = LEGEND_TITLE
  ) +

  theme_void() +

  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0,
      size = COMBINED_LEGEND_TITLE_SIZE,
      margin = margin(
        b = 6
      )
    ),

    plot.margin = margin(
      t = 2,
      r = 5,
      b = 5,
      l = 20
    )
  )

circle_for_combined <- combined_circular_plot +
  theme(
    legend.position = "none",
    plot.margin = margin(
      0,
      0,
      0,
      0
    )
  )

left_column <- (
  wio_summary_plot /
    legend_panel
) +
  plot_layout(
    heights = COMBINED_TOP_BOTTOM_HEIGHTS
  )

combined_plot <- (
  left_column |
    circle_for_combined
) +
  plot_layout(
    widths = COMBINED_LEFT_RIGHT_WIDTHS
  )

ggsave(
  filename = file.path(
    PLOT_DIR,
    "element4_5_connectivity_WIO_summary_and_circular.png"
  ),
  plot = combined_plot,
  width = COMBINED_FIGURE_WIDTH,
  height = COMBINED_FIGURE_HEIGHT,
  dpi = 400,
  bg = "white"
)


# 11. Save plotting data ---------------------------------------------------

write_csv(
  plot_data |>
    select(
      sovereign_state,
      indicator,
      value,
      bar_id
    ),
  file.path(
    OUTPUT_DIR,
    "element4_5_connectivity_circular_plot_data.csv"
  )
)

write_csv(
  wio_plot_data |>
    transmute(
      indicator = as.character(indicator),
      wio_percent_protected = value,
      wio_slot = as.character(wio_slot)
    ),
  file.path(
    OUTPUT_DIR,
    "element4_5_connectivity_WIO_plot_data.csv"
  )
)

print(combined_plot)
